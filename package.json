{
  "name": "hydrant",
  "version": "0.1.0",
  "private": true,
  "homepage": ".",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "ci-all": "npm test && npm run lint && npm run format:check",
    "dev": "react-router dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "postinstall": "chakra typegen src/components/ui/theme.ts && react-router typegen",
    "preview": "vite preview",
    "test": "vitest --run --reporter=verbose",
    "test:watch": "vitest --reporter=verbose"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fullcalendar/react": "^7.1.0",
    "@react-router/node": "^8.4.0",
    "@rjsf/chakra-ui": "^6.10.1",
    "@rjsf/core": "^6.10.1",
    "@rjsf/utils": "^6.10.1",
    "@rjsf/validator-ajv8": "^6.10.1",
    "ag-grid-react": "^36.2.0",
    "html-entities": "^2.6.0",
    "ical-generator": "^11.1.1",
    "isbot": "^5.2.2",
    "msgpackr": "^2.1.0",
    "nanoid": "^6.0.1",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-router": "^8.4.0",
    "rrule-temporal": "^2.2.6",
    "smol-toml": "^1.8.0",
    "temporal-polyfill": "^1.0.5",
    "timezones-ical-library": "^2.3.2"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.37.0",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.4.0",
    "@react-router/fs-routes": "^8.4.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "^30.1.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0 || >=26.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.4": true
  }
}
