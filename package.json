{
  "name": "hydrant",
  "version": "0.1.0",
  "private": true,
  "homepage": ".",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "ci-all": "npm test && npm run lint && npm run format:check",
    "dev": "react-router dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "postinstall": "chakra typegen src/components/ui/theme.ts && react-router typegen",
    "preview": "vite preview",
    "test": "vitest --run --reporter=verbose",
    "test:watch": "vitest --reporter=verbose"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.38.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fullcalendar/react": "^7.1.5",
    "@react-router/node": "^8.5.3",
    "@rjsf/chakra-ui": "^6.11.1",
    "@rjsf/core": "^6.11.1",
    "@rjsf/utils": "^6.11.1",
    "@rjsf/validator-ajv8": "^6.11.1",
    "ag-grid-react": "^36.3.0",
    "html-entities": "^2.6.0",
    "ical-generator": "^11.1.4",
    "isbot": "^5.2.4",
    "msgpackr": "^2.1.4",
    "nanoid": "^6.0.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router": "^8.5.3",
    "rrule-temporal": "^2.3.0",
    "smol-toml": "^1.9.1",
    "temporal-polyfill": "^1.0.8",
    "timezones-ical-library": "^3.0.0"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.38.0",
    "@react-router/dev": "^8.5.3",
    "@react-router/fs-routes": "^8.5.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "^31.0.1",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0 || >=26.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.7": true
  }
